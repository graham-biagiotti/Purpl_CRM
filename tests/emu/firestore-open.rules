rules_version = '2';
// Harness-only rules: the two-client mu/fuzz/probe harnesses run UNAUTHENTICATED
// clients against the emulator to test db.js mechanics, not security. The real
// production rules are verified separately by rules-tests.js, which loads
// ../../firestore.rules (synced copy: firestore.rules here) explicitly through
// @firebase/rules-unit-testing — that path ignores this file entirely.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if true; }
  }
}
