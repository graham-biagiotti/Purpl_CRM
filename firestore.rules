rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the authenticated user has admin role
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper: check if the authenticated user is admin or employee
    function isStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'employee'];
    }

    // Helper: road sales rep. Deliberately NOT staff — a field login can
    // touch field_logs only; every other collection stays denied.
    function isField() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'field';
    }

    // Users collection: user can read own doc, admins can read/write all.
    // Create rule blocks role field — prevents self-elevation.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null
        && request.auth.uid == userId
        && !('role' in request.resource.data);
      allow update, delete: if isAdmin();
    }

    // App config (access_control, etc.): admin-only write, staff read
    match /app_config/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Accounts and prospects: staff only (LAYER 2 — was request.auth != null)
    match /accounts/{accountId} {
      allow read, write: if isStaff();
    }

    match /prospects/{prospectId} {
      allow read, write: if isStaff();
    }

    // Portal: public can submit orders (create only)
    match /portal_orders/{orderId} {
      allow create: if true
        && request.resource.data.keys().hasAll(['accountName', 'billingEmail', 'status'])
        && request.resource.data.accountName is string
        && request.resource.data.accountName.size() < 200
        && request.resource.data.billingEmail is string
        && request.resource.data.billingEmail.size() < 200
        && request.resource.data.status in ['new', 'pending']
        && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() < 2000))
        && (!('items' in request.resource.data) || request.resource.data.items.size() < 50)
        && (!('lineItems' in request.resource.data) || request.resource.data.lineItems.size() < 50)
        && request.resource.data.size() < 50;
      allow read: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // In-store sampling requests: created ONLY by Cloud Functions (admin
    // SDK), never from a public client. Staff read/update for the CRM
    // Sampling page; delete stays admin-only.
    match /sampling_requests/{requestId} {
      allow read, update: if isStaff();
      allow delete: if isAdmin();
      allow create: if false;
    }

    // Purchase orders (supplier POs, e.g. sugar): staff-only, standalone —
    // no public access of any kind. Includes the _meta counter doc.
    match /purchase_orders/{poId} {
      allow read, write: if isStaff();
    }

    // Field log: road-rep visit entries. Field reps create logs stamped
    // with their own uid and read/fix ONLY their own; staff read/update
    // all (review stamps); delete stays admin-only. Never public.
    match /field_logs/{logId} {
      allow read: if isStaff() || (isField() && resource.data.uid == request.auth.uid);
      allow create: if (isStaff() || isField())
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'createdAt', 'storeName'])
        && request.resource.data.storeName is string
        && request.resource.data.storeName.size() > 0
        && request.resource.data.storeName.size() < 200
        && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() < 8000))
        && (!('extras' in request.resource.data) || (request.resource.data.extras is list && request.resource.data.extras.size() <= 30))
        && request.resource.data.size() < 40;
      // Field reps create-only (the /field page never edits a log). Updates
      // — reviewed flags, applied stamps — are staff-only, so a field login
      // cannot hide its own entries or forge applied-stamps.
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    // Portal: public can sign up for notifications
    match /portal_notify/{docId} {
      allow create: if true
        && request.resource.data.keys().hasAll(['email', 'flavor'])
        && request.resource.data.email is string
        && request.resource.data.email.size() < 200
        && request.resource.data.flavor is string
        && request.resource.data.flavor.size() < 100
        && request.resource.data.size() < 10;
      allow read, delete: if isStaff();
    }

    // Portal settings: admin-only write, staff read
    match /portal_settings/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Portal config: admin-only write, staff read
    match /portal_config/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Portal tokens: admin-only write, staff read
    match /portal_tokens/{docId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // Wholesale page: public can submit inquiries
    match /portal_inquiries/{docId} {
      allow create: if true
        && request.resource.data.keys().hasAll(['businessName', 'email'])
        && request.resource.data.businessName is string
        && request.resource.data.businessName.size() < 200
        && request.resource.data.email is string
        && request.resource.data.email.size() < 200
        && (!('message' in request.resource.data) || (request.resource.data.message is string && request.resource.data.message.size() < 5000))
        && request.resource.data.size() < 20;
      allow read, update, delete: if isStaff();
    }

    // Workspace data: LAYER 2 — requires staff role (was request.auth != null)
    // HIGH-7: audit_log is APPEND-ONLY. The client (db.js) legitimately CREATEs
    // audit entries under the signed-in user's auth, so a blanket `write:false`
    // would break audit logging entirely (permission-denied on every audited
    // action). Tamper-proofing comes from denying UPDATE and DELETE — once
    // written, an entry can never be altered or removed by a client.
    // A dedicated `match` is NOT enough on its own: the recursive
    // `workspace/{path=**}` below ALSO matches audit_log docs, and Firestore
    // grants access if ANY matching rule allows it. So the catch-all must keep
    // excluding audit_log writes (see its condition), and this match re-grants
    // ONLY create.
    match /workspace/main/audit_log/{docId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }
    // NOTE: invoice deletion, config changes, etc. are all isStaff() for now.
    // If you want admin-only delete on invoices or admin-only write on
    // invoice_settings, let me know and I'll add those sub-matches.
    match /workspace/{path=**} {
      allow read: if isStaff();
      // isStaff for all workspace writes EXCEPT audit_log, which stays
      // immutable from the client. Size guard prevents an index error on
      // short paths (e.g. a write to workspace/main itself).
      allow write: if isStaff()
        && !(path.size() >= 2 && path[0] == 'main' && path[1] == 'audit_log');
    }

    // Default posture: DENY. No catch-all rule.
    // Cloud Functions using Admin SDK bypass these rules entirely.
  }
}
